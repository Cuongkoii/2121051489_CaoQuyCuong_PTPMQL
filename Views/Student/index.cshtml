@model List<ptpmql.ViewModels.StudentFacultyVM>

<h2>Danh sách sinh viên</h2>

<a asp-action="Create">Thêm mới</a>

<table border="1">
    <tr>
        <th>Mã SV</th>
        <th>Họ tên</th>
        <th>Khoa</th> <!-- ✅ thêm -->
        <th>Hành động</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.StudentCode</td>
            <td>@item.FullName</td>
            <td>@item.FacultyName</td> <!-- ✅ thêm -->
            <td>
                <a asp-action="Edit" asp-route-id="@item.StudentCode">Sửa</a> |
                <a asp-action="Delete" asp-route-id="@item.StudentCode">Xoá</a>
            </td>
        </tr>
    }
</table>
<a asp-controller="DocDuLieu" asp-action="Upload">
    Import Excel
</a>